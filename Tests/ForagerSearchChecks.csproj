<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ForagerSearchChecks.cs" />
    <Compile Include="../Workers/Navigation/WorkerBoundedCandidateSearch.cs" Link="WorkerBoundedCandidateSearch.cs" />
    <Compile Include="../Workers/Navigation/WorkerForagerApproachMatcher.cs" Link="WorkerForagerApproachMatcher.cs" />
    <Reference Include="MonoGame.Framework">
      <HintPath>$(GamePath)/MonoGame.Framework.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
