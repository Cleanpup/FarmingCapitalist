<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HireSkilledHelpers</AssemblyName>
    <RootNamespace>HireSkilledHelpers</RootNamespace>
    <ModFolderName>HireSkilledHelpers</ModFolderName>
    <EnableHarmony>true</EnableHarmony>
    <!-- Reference source and test harnesses are not part of the shipped mod. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);StardewValleyDecompiled/**;SMAPI/**;Tests/**</DefaultItemExcludes>
    <!-- If the package can't detect your game path, uncomment and set GamePath. -->
    <!-- <GamePath>/path/to/Stardew Valley</GamePath> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="assets/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
